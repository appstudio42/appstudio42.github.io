---
import Brand from "../ui/Brand.astro";
import { site } from "../../data/site";
import { getContent, pagePath, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const content = getContent(locale);
const home = pagePath(locale);
---

<footer class="site-footer">
  <div class="shell" style="display: grid; gap: 2rem;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem;">
      <div>
        <Brand href={home} />
        <p style="margin-top: 0.85rem; color: var(--color-muted); max-width: 28ch;">
          {content.footer.tagline}
        </p>
      </div>

      <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
        <div>
          <p class="footer-label">App Studio 42</p>
          <ul class="footer-list">
            <li>
              <a class="footer-link" href={site.githubOrg} rel="noopener noreferrer">{content.footer.org}</a>
            </li>
            <li>
              <a class="footer-link" href={site.licenseUrl} rel="noopener noreferrer">{content.footer.license}</a>
            </li>
          </ul>
        </div>
        <div>
          <p class="footer-label">{content.footer.sistersLabel}</p>
          <ul class="footer-list">
            {site.sisters.map((sister) => (
              <li>
                <a class="footer-link" href={sister.url} rel="noopener noreferrer">{sister.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <p style="font-size: 0.85rem; color: var(--color-subtle); border-top: 1px solid var(--color-line); padding-top: 1.25rem;">
      {content.footer.rights}
    </p>
  </div>
</footer>

<style>
  .footer-label {
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-subtle);
    margin-bottom: 0.55rem;
  }

  .footer-list {
    display: grid;
    gap: 0.15rem;
  }
</style>
