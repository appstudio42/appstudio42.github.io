---
import SectionHead from "../ui/SectionHead.astro";
import { getContent, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const content = getContent(locale);
const accents = ["coral", "mint", "sky", "sun"] as const;

const icons = {
  "open-source": `<path d="M12 3.5A8.5 8.5 0 1 0 20.5 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M15 9l5-1-1 5-4-4Z" fill="currentColor"/>`,
  privacy: `<rect x="6" y="10" width="12" height="10" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M9 10V8a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>`,
  free: `<circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v8M9.5 10.5c.5-1 1.5-1.5 2.5-1.5s2 .6 2 1.7c0 2.3-4.5 1.4-4.5 3.8 0 1.1.9 1.8 2.2 1.8s2-.5 2.5-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>`,
  distribute: `<path d="M12 4v10m0 0 3.5-3.5M12 14l-3.5-3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 17.5V19a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>`,
} as const;
---

<section
  class="section shell"
  id={locale === "en" ? "principles" : "principios"}
  aria-labelledby="principles-title"
>
  <SectionHead
    index={content.principles.index}
    eyebrow={content.principles.eyebrow}
    title={content.principles.title}
    subtitle={content.principles.subtitle}
  />
  <div id="principles-title" class="sr-only">{content.principles.title}</div>

  <div class="principle-grid" style="margin-top: 2.25rem;">
    {content.principles.items.map((item, index) => (
      <article
        class="principle"
        data-accent={accents[index % accents.length]}
        data-reveal
        style={`--d: ${index}`}
      >
        <div class="principle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" set:html={icons[item.id as keyof typeof icons]} />
        </div>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
