---
import "../styles/global.css";
import { site } from "../data/site";
import { buildSeo } from "../lib/seo";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, path, title, description, noindex = false } = Astro.props;
const seo = buildSeo({ locale, path, title, description, noindex });
const { content } = seo;
---

<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={seo.canonical} />

    {seo.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}

    <meta name="theme-color" content={site.themeColorLight} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={site.themeColorDark} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={site.name} />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={content.meta.ogLocale} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="preload"
      href="/fonts/outfit-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/nunito-sans-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add("js");
      (() => {
        try {
          const stored = localStorage.getItem("as42-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (_) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(seo.schema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">{content.a11y.skip}</a>
    <slot />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 200;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: var(--color-fg);
    color: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 700;
    transition: top 0.25s ease;
  }

  .skip-link:focus-visible {
    top: 1rem;
  }
</style>
